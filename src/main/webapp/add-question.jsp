<%@ page contentType="text/html;charset=UTF-8" %><% if(session.getAttribute("adminId")==null){response.sendRedirect("admin-login.jsp");return;} %><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Add Question | CodeQuest</title><link rel="stylesheet" href="css/style.css"></head><body><nav class="nav"><a class="brand" href="index.html">Code<span>Quest</span></a><div class="navlinks"><a href="admin-dashboard.jsp">Admin Home</a><a href="admin-logout">Logout</a></div></nav><main class="container"><section class="form-card"><h1>Create a mission</h1><% String error=(String)request.getAttribute("error");if(error!=null){ %><div class="alert"><%= firstphase.WebUtil.esc(error) %></div><% } %><form method="post" action="admin/add-question"><label>Question title</label><input name="title" maxlength="100" required><label>Description / question</label><textarea name="description" required></textarea><div class="row"><div><label>Category</label><select name="category"><option>Java</option><option>SQL</option><option>DSA</option></select></div><div><label>Difficulty</label><select name="difficulty"><option>Easy</option><option>Medium</option><option>Hard</option></select></div></div><div class="row"><div><label>Option A</label><input name="optionA" required></div><div><label>Option B</label><input name="optionB" required></div><div><label>Option C</label><input name="optionC" required></div><div><label>Option D</label><input name="optionD" required></div></div><label>Correct answer (must exactly match one option)</label><input name="correctAnswer" required><label>XP reward</label><input type="number" name="xpReward" min="1" max="1000" value="50" required><p><button class="btn" type="submit">Save Mission</button></p></form></section></main></body></html>