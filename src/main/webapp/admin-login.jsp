<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin Login | CodeQuest</title><link rel="stylesheet" href="css/style.css"></head><body><nav class="nav"><a class="brand" href="index.html">Code<span>Quest</span></a><div class="navlinks"><a href="index.html">Home</a></div></nav><main class="container"><section class="form-card"><h1>Admin Portal</h1><p class="muted">Sign in to manage programming missions.</p><% String error=(String)request.getAttribute("error");if(error!=null){ %><div class="alert"><%= firstphase.WebUtil.esc(error) %></div><% } %><form method="post" action="admin-login"><label>Admin username</label><input name="username" required><label>Password</label><input type="password" name="password" required><p><button class="btn" type="submit">Admin Sign In</button></p></form><p class="muted small">Default local demo: admin / admin123</p></section></main></body></html>