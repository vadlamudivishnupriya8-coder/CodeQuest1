<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="firstphase.WebUtil" %><% if(session.getAttribute("studentId")==null){response.sendRedirect("login.jsp");return;} String username=(String)request.getAttribute("username");Integer xp=(Integer)request.getAttribute("xp"),level=(Integer)request.getAttribute("level"),completed=(Integer)request.getAttribute("completed"),progress=(Integer)request.getAttribute("progress"),toNext=(Integer)request.getAttribute("xpToNext");if(username==null){response.sendRedirect("dashboard");return;} String[] names={"Beginner Coder","Code Explorer","Logic Builder","Java Developer","Programming Master","Code Champion"};String levelName=names[Math.min(level-1,names.length-1)];%><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Dashboard | CodeQuest</title><link rel="stylesheet" href="css/style.css"></head><body><nav class="nav"><a class="brand" href="index.html">Code<span>Quest</span></a><div class="navlinks"><a href="missions">Missions</a><a href="leaderboard">Leaderboard</a><a href="logout">Logout</a></div></nav><main class="container"><div class="eyebrow">PLAYER DASHBOARD</div><h1>Welcome, <%= WebUtil.esc(username) %>!</h1><p class="muted">Your next breakthrough is one challenge away.</p><section class="grid"><article class="card"><div class="muted">TOTAL XP</div><div class="stat"><%= xp %></div></article><article class="card"><div class="muted">CURRENT LEVEL</div><div class="stat">Lv. <%= level %></div><strong><%= levelName %></strong></article><article class="card"><div class="muted">MISSIONS COMPLETED</div><div class="stat"><%= completed %></div></article></section><section class="card" style="margin-top:20px"><div style="display:flex;justify-content:space-between;gap:12px"><strong>Level <%= level %> progress</strong><span class="muted"><%= toNext %> XP to next level</span></div><div class="progress" style="margin:14px 0"><span style="width:<%= progress %>%"></span></div><p class="muted small">Level up every 200 XP.</p></section><div class="actions"><a class="btn" href="missions">Explore Missions</a><a class="btn secondary" href="leaderboard">View Leaderboard</a></div></main></body></html>