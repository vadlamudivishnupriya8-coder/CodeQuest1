<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,firstphase.LeaderboardUser,firstphase.WebUtil" %><% List<LeaderboardUser> list=(List<LeaderboardUser>)request.getAttribute("leaderboard");if(list==null){response.sendRedirect("leaderboard");return;} %><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Leaderboard | CodeQuest</title><link rel="stylesheet" href="css/style.css"></head><body><nav class="nav"><a class="brand" href="index.html">Code<span>Quest</span></a><div class="navlinks"><a href="dashboard">Dashboard</a><a href="missions">Missions</a><a href="logout">Logout</a></div></nav><main class="container"><div class="eyebrow">GLOBAL RANKINGS</div><h1>CodeQuest Leaderboard</h1><p class="muted">The highest XP players lead the quest.</p><% if(list.isEmpty()){ %><div class="card">No players yet. Be the first to join!</div><% }else{ %><div class="table-wrap"><table><thead><tr><th>Rank</th><th>Player</th><th>Level</th><th>Completed</th><th>Total XP</th></tr></thead><tbody><% for(LeaderboardUser u:list){String medal=u.getRank()==1?"🥇":u.getRank()==2?"🥈":u.getRank()==3?"🥉":"";%><tr><td class="podium"><%= medal %> #<%= u.getRank() %></td><td><%= WebUtil.esc(u.getUsername()) %></td><td><%= u.getLevel() %></td><td><%= u.getCompletedMissions() %></td><td><strong><%= u.getTotalXp() %> XP</strong></td></tr><% } %></tbody></table></div><% } %></main></body></html>