<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="jakarta.servlet.http.Cookie" %><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Login | CodeQuest</title><link rel="stylesheet" href="css/style.css"></head><body><nav class="nav"><a class="brand" href="index.html">Code<span>Quest</span></a><div class="navlinks"><a href="register.jsp">Register</a><a href="index.html">Home</a></div></nav><main class="container"><section class="form-card"><h1>Welcome back</h1><p class="muted">Pick up where your coding quest left off.</p><% String error=(String)request.getAttribute("error"); if(error!=null){ %><div class="alert"><%= firstphase.WebUtil.esc(error) %></div><% } if("1".equals(request.getParameter("registered"))){ %><div class="alert success">Registration successful. Please log in.</div><% } if("1".equals(request.getParameter("logout"))){ %><div class="alert success">You have logged out.</div><% } String remembered=""; Cookie[] cookies=request.getCookies();if(cookies!=null){for(Cookie ck:cookies){if("cq_user".equals(ck.getName()))remembered=ck.getValue();}} %><form method="post" action="login"><label>Username or email</label><input name="identity" value="<%= firstphase.WebUtil.esc(remembered) %>" required><label>Password</label><input type="password" name="password" required><label><input type="checkbox" name="remember" style="width:auto"> Remember my username for 7 days</label><p><button class="btn" type="submit">Login to CodeQuest</button></p></form><p class="muted small">New player? <a href="register.jsp">Create an account</a></p></section></main></body></html>