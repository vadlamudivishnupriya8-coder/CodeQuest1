<%@ page contentType="text/html;charset=UTF-8" %><% if(session.getAttribute("studentId")==null){response.sendRedirect("login.jsp");return;} Boolean correct=(Boolean)request.getAttribute("correct");Integer earned=(Integer)request.getAttribute("earned"),total=(Integer)request.getAttribute("totalXp"),level=(Integer)request.getAttribute("level");Boolean levelUp=(Boolean)request.getAttribute("levelUp");String message=(String)request.getAttribute("message");%><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Mission Result | CodeQuest</title><link rel="stylesheet" href="css/style.css"></head><body><main class="container"><section class="form-card center"><div class="eyebrow">MISSION REPORT</div><% if(message!=null){ %><h1>Already attempted</h1><p class="muted"><%= firstphase.WebUtil.esc(message) %></p><% }else if(Boolean.TRUE.equals(correct)){ %><h1 class="gradient">Correct Answer!</h1><p class="lead">Excellent work. Your logic is leveling up.</p><div class="stat">+<%= earned %> XP</div><p>Total XP: <strong><%= total %></strong> · Level <strong><%= level %></strong></p><% if(Boolean.TRUE.equals(levelUp)){ %><div class="levelup">LEVEL UP! You unlocked Level <%= level %>.</div><% } %><% }else{ %><h1>Not quite!</h1><p class="muted">No XP earned this time. Keep learning and try another mission.</p><div class="stat">+0 XP</div><% } %><div class="actions" style="justify-content:center"><a class="btn" href="dashboard">Dashboard</a><a class="btn secondary" href="missions">More Missions</a></div></section></main></body></html>