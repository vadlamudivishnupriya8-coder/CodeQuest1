<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,firstphase.Mission,firstphase.WebUtil" %><% if(session.getAttribute("studentId")==null){response.sendRedirect("login.jsp");return;} List<Mission> missions=(List<Mission>)request.getAttribute("missions");if(missions==null){response.sendRedirect("missions");return;} String cat=(String)request.getAttribute("category");%><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Missions | CodeQuest</title><link rel="stylesheet" href="css/style.css"></head><body><nav class="nav"><a class="brand" href="index.html">Code<span>Quest</span></a><div class="navlinks"><a href="dashboard">Dashboard</a><a href="leaderboard">Leaderboard</a><a href="logout">Logout</a></div></nav><main class="container"><div class="eyebrow">CHALLENGE ARENA</div><h1>Choose your next mission</h1><div class="filters"><a href="missions">All</a><a href="missions?category=Java">Java</a><a href="missions?category=SQL">SQL</a><a href="missions?category=DSA">DSA</a></div><% if(missions.isEmpty()){ %><div class="card">No missions found. Check back soon!</div><% } for(Mission m:missions){ %><article class="mission <%= m.isAttempted()?"disabled":"" %>"><div><span class="tag"><%= WebUtil.esc(m.getCategory()) %></span><span class="tag purple"><%= WebUtil.esc(m.getDifficulty()) %></span><span class="tag"><%= m.getXpReward() %> XP</span></div><h3><%= WebUtil.esc(m.getTitle()) %></h3><p class="muted"><%= WebUtil.esc(m.getDescription()) %></p><% if(m.isAttempted()){ %><div class="alert success">Attempted — one attempt per mission.</div><% }else{ %><form method="post" action="submit-answer"><input type="hidden" name="missionId" value="<%= m.getId() %>"><div class="options"><div class="option"><label><input type="radio" name="answer" value="<%= WebUtil.esc(m.getOptionA()) %>" required><%= WebUtil.esc(m.getOptionA()) %></label></div><div class="option"><label><input type="radio" name="answer" value="<%= WebUtil.esc(m.getOptionB()) %>"><%= WebUtil.esc(m.getOptionB()) %></label></div><div class="option"><label><input type="radio" name="answer" value="<%= WebUtil.esc(m.getOptionC()) %>"><%= WebUtil.esc(m.getOptionC()) %></label></div><div class="option"><label><input type="radio" name="answer" value="<%= WebUtil.esc(m.getOptionD()) %>"><%= WebUtil.esc(m.getOptionD()) %></label></div></div><button class="btn" type="submit">Submit Answer</button></form><% } %></article><% } %></main></body></html>