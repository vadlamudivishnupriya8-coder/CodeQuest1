<%@ page contentType="text/html;charset=UTF-8" %><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Register | CodeQuest</title><link rel="stylesheet" href="css/style.css"></head><body><nav class="nav"><a class="brand" href="index.html">Code<span>Quest</span></a><div class="navlinks"><a href="login.jsp">Login</a><a href="index.html">Home</a></div></nav><main class="container"><section class="form-card"><h1>Create your player account</h1><p class="muted">Join the quest. Your first level starts here.</p><% String error=(String)request.getAttribute("error"); if(error!=null){ %><div class="alert"><%= firstphase.WebUtil.esc(error) %></div><% } %><form method="post" action="register"><label>Username</label><input name="username" maxlength="50" required><label>Email</label><input type="email" name="email" maxlength="100" required><label>Password</label><input type="password" name="password" minlength="8" required><label>Confirm password</label><input type="password" name="confirmPassword" minlength="8" required><p><button class="btn" type="submit">Create Account</button></p></form><p class="muted small">Already registered? <a href="login.jsp">Log in</a></p></section></main></body></html>