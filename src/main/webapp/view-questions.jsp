<%@ page contentType="text/html;charset=UTF-8" %><%@ page import="java.util.*,firstphase.Mission,firstphase.WebUtil" %><% if(session.getAttribute("adminId")==null){response.sendRedirect("admin-login.jsp");return;} List<Mission> list=(List<Mission>)request.getAttribute("missions");if(list==null){response.sendRedirect("admin/view-questions");return;} %><!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Question Library | CodeQuest</title><link rel="stylesheet" href="css/style.css"></head><body><nav class="nav"><a class="brand" href="index.html">Code<span>Quest</span></a><div class="navlinks"><a href="admin-dashboard.jsp">Admin Home</a><a href="admin-logout">Logout</a></div></nav><main class="container"><div class="eyebrow">MISSION MANAGEMENT</div><h1>Question Library</h1><div class="actions"><a class="btn" href="add-question.jsp">Add New Question</a></div><% if(list.isEmpty()){ %><div class="card">No questions have been added.</div><% }else{ %><div class="table-wrap"><table><thead><tr><th>ID</th><th>Title</th><th>Category</th><th>Difficulty</th><th>XP Reward</th></tr></thead><tbody><% for(Mission m:list){ %><tr><td><%= m.getId() %></td><td><%= WebUtil.esc(m.getTitle()) %></td><td><%= WebUtil.esc(m.getCategory()) %></td><td><%= WebUtil.esc(m.getDifficulty()) %></td><td><%= m.getXpReward() %></td></tr><% } %></tbody></table></div><% } %></main></body></html>